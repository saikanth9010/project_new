NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173

# For local Docker, set the password here to the same value as POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://northstar:change-this-local-database-password@127.0.0.1:5432/northstar
DATABASE_SSL=disable
DATABASE_CA_CERT=
DB_POOL_MAX=10
# Comma-separated additional database hostnames allowed by the admin test screen.
DATABASE_ALLOWED_HOSTS=
POSTGRES_PASSWORD=change-this-local-database-password

# In production, use a restricted runtime account for DATABASE_URL and separate owner credentials here.
MIGRATION_DATABASE_URL=
ADMIN_DATABASE_URL=

# Use a unique, random value for local development; never commit .env.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_NAME=Security Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-this-with-a-long-unique-password
BOOTSTRAP_TENANT_NAME=Northstar Security
BOOTSTRAP_TENANT_SLUG=northstar

# Optional Casdoor OIDC sign-in. The website callback URL is:
# https://your-operations-host.example/api/auth/casdoor/callback
# Set the exact issuer returned in Casdoor's OIDC discovery document.
CASDOOR_ISSUER=
# Optional override for app-specific Casdoor discovery documents.
CASDOOR_DISCOVERY_URL=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
