NODE_ENV=production
ADMIN_DATABASE_URL=postgresql://northstar_owner:REPLACE_WITH_URL_ENCODED_PASSWORD@db.example.internal:5432/northstar
DATABASE_SSL=verify-full
DATABASE_CA_CERT=/run/secrets/database-ca.pem
DB_POOL_MAX=2
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Security Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
BOOTSTRAP_TENANT_NAME=Northstar Security
BOOTSTRAP_TENANT_SLUG=northstar
